{
  "name": "catalogo-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de catalogo de produtos em Node, TypeScript, Express e Prisma",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "postinstall": "npm run generate:all",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run db:test:prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:test:prepare": "npm run generate:all && prisma db push --schema=prisma/schema.sqlite.prisma --skip-generate --accept-data-loss",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "generate:all": "node scripts/gen-sqlite-schema.mjs && prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.6",
    "express": "5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "prisma": "6.19.3",
    "supertest": "^7.1.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
