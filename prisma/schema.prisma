// Fonte da verdade do modelo de dados. O provider e o PostgreSQL 15 que sobe
// pelo docker-compose. O schema equivalente de SQLite, usado pela suite de
// testes, e derivado deste arquivo por scripts/gen-sqlite-schema.mjs.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/pg"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(120)
  description String
  imageUrl    String   @db.VarChar(2048)
  price       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

// Conta que pode escrever no catalogo. O e-mail chega normalizado em
// minusculas pelo Zod, entao o indice unico basta para barrar duplicata que
// muda so a caixa. A senha nunca e gravada: so o hash do bcrypt, que tem 60
// caracteres.
model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(60)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
