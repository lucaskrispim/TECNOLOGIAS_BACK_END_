# Copie para .env antes de subir o Docker: cp .env.example .env
# O docker-compose le estas variaveis para criar o banco, e o Prisma le a
# DATABASE_URL para migrations, seed e Studio.

POSTGRES_USER=catalogo
POSTGRES_PASSWORD=catalogo
POSTGRES_DB=catalogo
POSTGRES_PORT=5432

DATABASE_URL="postgresql://catalogo:catalogo@localhost:5432/catalogo?schema=public"

# Porta da API
PORT=3000

# Origens liberadas no CORS, separadas por virgula. Sem a variavel, vale
# http://localhost:5173, a porta padrao do Vite.
ALLOWED_ORIGIN=http://localhost:5173

# Banco usado pela aplicacao: postgresql (padrao) ou sqlite.
# DB_DRIVER=sqlite

# Autenticacao (tarefa 3).
# JWT_SECRET assina os tokens e precisa de no minimo 32 caracteres; sem ele a
# API nao sobe. Gere um valor proprio, nao use o deste exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# Validade do token: 7d, 12h, 3600 (segundos).
JWT_EXPIRES_IN=7d
# Custo do bcrypt, de 4 a 15. Cada ponto a mais dobra o tempo do hash.
BCRYPT_ROUNDS=10
